# ─── Base de datos ───────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root_password_seguro
MYSQL_DATABASE=recetas_db
MYSQL_USER=recetas_user
MYSQL_PASSWORD=password_seguro

# SQLAlchemy URL (generada automáticamente por docker-compose, también puede configurarse manualmente)
DATABASE_URL=mysql+pymysql://recetas_user:password_seguro@localhost:3306/recetas_db

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Genera un valor seguro con: openssl rand -hex 32
SECRET_KEY=cambia_esto_con_un_valor_muy_seguro_generado_aleatoriamente
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o-mini

# ─── App ─────────────────────────────────────────────────────────────────────
APP_URL=https://tu-dominio.com
